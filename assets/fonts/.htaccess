# Fonts may be used by pages on another address of the same site (with/without www, the Windows app).
<IfModule mod_headers.c>
	<FilesMatch "\.(woff2?|ttf)$">
		Header set Access-Control-Allow-Origin "*"
	</FilesMatch>
</IfModule>
<IfModule mod_mime.c>
	AddType font/woff2 .woff2
	AddType font/ttf .ttf
</IfModule>
