<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_row"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/tick"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="4dp"
            android:src="@drawable/tick_off"
            android:contentDescription="انجام شد" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView android:id="@+id/lock" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginEnd="6dp" android:background="@drawable/bg_lock_ico" android:scaleType="center"
                    android:src="@drawable/ic_lock" android:visibility="gone" android:contentDescription="تعیین‌شده توسط ناظر" />
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxWidth="200dp" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"
                    android:maxLines="2" android:ellipsize="end" />
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/urgent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:background="@drawable/bg_chip_danger" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="1dp" android:paddingBottom="1dp" android:text="فوری" android:textColor="@color/danger"
                    android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/fresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:background="@drawable/bg_chip_lock" android:paddingStart="9dp" android:paddingEnd="9dp"
                    android:paddingTop="1dp" android:paddingBottom="1dp" android:text="جدید" android:textColor="@color/lock"
                    android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/due" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" android:textColor="@color/danger" android:textSize="12sp" android:textStyle="bold"
                    android:maxLines="1" android:visibility="gone" />
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" android:drawableStart="@drawable/ic_clock" android:drawablePadding="4dp"
                    android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1" android:visibility="gone" />
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/project" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="10dp" android:drawableStart="@drawable/ic_folder" android:drawablePadding="4dp"
                    android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
                <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/items" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_list" android:drawablePadding="4dp"
                    android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
