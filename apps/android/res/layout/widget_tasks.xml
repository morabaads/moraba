<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_widget"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تسک‌ها"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_seg"
            android:padding="4dp">
            <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/tab_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="امروز" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/muted" />
            <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/tab_week" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="هفته" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/muted" />
            <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="viewStart" android:id="@+id/tab_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="عقب‌افتاده" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/muted" />
        </LinearLayout>

        <ImageView
            android:id="@+id/add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_plus"
            android:scaleType="center"
            android:src="@drawable/ic_plus"
            android:contentDescription="تسک جدید" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />
        <TextView style="@style/W" android:textDirection="anyRtl" android:textAlignment="center"
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="امروز تسکی ندارید"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
