[["<svg class=\"i\"><use href=\"#i-link\"/></svg>", "فقط آدرس را بچسبانید", "آدرس محصول یا دسته را وارد کنید؛ کوچ پلتفرم و ارز را خودکار تشخیص می‌دهد و ویزارد سه‌مرحله‌ای شما را تا انتقال همراهی می‌کند.", "افزودن کوچ جدید", "\n        <div class=\"steps\"><div class=\"on\">۱ · آدرس</div><div>۲ · پیش‌نمایش</div><div>۳ · قیمت و زمان</div></div>\n        <div class=\"input\">https://shop.example.com/product/sneaker-x</div>\n        <div class=\"btn\">تشخیص و ادامه</div>\n        <div class=\"chips\"><span class=\"chip ok\"><svg class=\"i\"><use href=\"#i-check\"/></svg> ووکامرس تشخیص داده شد</span><span class=\"chip o\">ارز: تومان</span><span class=\"chip\">Store API</span></div>\n        <div class=\"fld\"><span class=\"l\">robots.txt</span><span class=\"v\">گزارش شد و رعایت می‌شود</span><span class=\"conf h\">امن</span></div>\n      "], ["<svg class=\"i\"><use href=\"#i-eye\"/></svg>", "اول پیش‌نمایش، بعد انتقال", "محصول دقیقاً همان‌طور که ذخیره می‌شود نمایش داده می‌شود، با درجه‌ی اطمینان برای هر فیلد. «تست‌ران» بدون نوشتن چیزی تغییرات را نشان می‌دهد.", "پیش‌نمایش نهایی", "\n        <div class=\"steps\"><div class=\"done\"><svg class=\"i\"><use href=\"#i-check\"/></svg> آدرس</div><div class=\"on\">۲ · پیش‌نمایش</div><div>۳ · قیمت و زمان</div></div>\n        <div class=\"prod\"><div class=\"im\"><svg class=\"i\"><use href=\"#i-box\"/></svg></div><div style=\"flex:1\"><b style=\"font-size:18px\">کفش ورزشی مدل X</b><div style=\"color:var(--mu);font-size:14px;margin-top:6px\">۴ متغیر · ۱۲ تصویر</div></div></div>\n        <div class=\"fld\"><span class=\"l\">عنوان</span><span class=\"v\">کفش ورزشی مدل X</span><span class=\"conf h\">۹۸٪</span></div>\n        <div class=\"fld\"><span class=\"l\">قیمت</span><span class=\"v\">۱٬۲۵۰٬۰۰۰ تومان</span><span class=\"conf h\">۹۵٪</span></div>\n        <div class=\"fld\"><span class=\"l\">دسته</span><span class=\"v\">کفش › مردانه</span><span class=\"conf m\">۷۲٪</span></div>\n        <div class=\"grid2\"><div class=\"btn g\">تست‌ران</div><div class=\"btn\">تأیید و شروع انتقال</div></div>\n      "], ["<svg class=\"i\"><use href=\"#i-globe\"/></svg>", "از هر منبع مجاز", "دیجی‌کالا، تکنولایف، ووکامرسی و سایت‌های اختصاصی. برای سایت‌های دیگر، انتخابگر بصری فیلد و سرویس رندر برای صفحه‌های جاوااسکریپتی.", "منابع پشتیبانی‌شده", "\n        <div class=\"grid2\">\n          <div class=\"tile\"><b>دیجی‌کالا</b><span>محصول و دسته</span></div>\n          <div class=\"tile\"><b>تکنولایف</b><span>فروشگاه‌های تکنولایف</span></div>\n          <div class=\"tile\"><b>ووکامرسی</b><span>فروشگاه‌های ووکامرسی</span></div>\n          <div class=\"tile\"><b>اختصاصی</b><span>سایت‌های اختصاصی</span></div>\n        </div>\n        <div class=\"fld\" style=\"margin-top:6px\"><span class=\"l\" style=\"width:auto\"><svg class=\"i\"><use href=\"#i-target\"/></svg></span><span class=\"v\">انتخابگر بصری فیلد برای سایت‌های دیگر</span></div>\n        <div class=\"fld\"><span class=\"l\" style=\"width:auto\"><svg class=\"i\"><use href=\"#i-cog\"/></svg></span><span class=\"v\">سرویس رندر اختیاری برای صفحه‌های JS</span></div>\n      "], ["<svg class=\"i\"><use href=\"#i-coins\"/></svg>", "قیمت‌گذاری هوشمند", "درصدی، مبلغ ثابت، پله‌ای یا بر اساس دسته؛ پایان جذاب (…۹۰۰)، نرخ ارز زنده و «نگهبان قیمت» که جهش‌های عجیب را برای تأیید شما نگه می‌دارد.", "قیمت و زمان‌بندی", "\n        <div class=\"steps\"><div class=\"done\"><svg class=\"i\"><use href=\"#i-check\"/></svg> آدرس</div><div class=\"done\"><svg class=\"i\"><use href=\"#i-check\"/></svg> پیش‌نمایش</div><div class=\"on\">۳ · قیمت و زمان</div></div>\n        <div class=\"line\"><span>قیمت منبع</span><b>۱٬۰۰۰٬۰۰۰</b></div>\n        <div class=\"line\"><span>حاشیه‌ی سود</span><b style=\"color:var(--o2)\">+۲۵٪</b></div>\n        <div class=\"line\"><span>پایان جذاب</span><span class=\"tgl\"></span></div>\n        <div class=\"line\"><span>نرخ ارز زنده</span><span class=\"tgl\"></span></div>\n        <div class=\"line\" style=\"border:0\"><span>قیمت فروش</span><b style=\"font-size:24px;color:var(--ok)\">۱٬۲۴۹٬۹۰۰ تومان</b></div>\n        <div class=\"chip o\" style=\"align-self:flex-start\"><svg class=\"i\"><use href=\"#i-shield\"/></svg> نگهبان قیمت فعال</div>\n      "], ["<svg class=\"i\"><use href=\"#i-refresh\"/></svg>", "همیشه به‌روز، بدون دردسر", "به‌روزرسانی کامل زمان‌بندی‌شده، تازه‌سازی سریع قیمت و موجودی، ساعات سکوت و مدیریت امن محصولاتی که از منبع حذف شده‌اند. قفل فیلدها ویرایش‌های خودتان را نگه می‌دارد.", "مدیریت کوچ", "\n        <div class=\"grid2\"><div class=\"tile\"><b>۱٬۲۴۸</b><span>محصول همگام</span></div><div class=\"tile\"><b>۳ دقیقه</b><span>آخرین به‌روزرسانی</span></div></div>\n        <div class=\"line\"><span>به‌روزرسانی کامل</span><span class=\"chip\">هر شب ۰۳:۰۰</span></div>\n        <div class=\"line\"><span>قیمت و موجودی سریع</span><span class=\"chip\">هر ۳۰ دقیقه</span></div>\n        <div class=\"line\"><span>ساعات سکوت</span><span class=\"chip\">۰۰:۰۰ – ۰۶:۰۰</span></div>\n        <div class=\"line\" style=\"border:0\"><span><svg class=\"i\"><use href=\"#i-lock\"/></svg> قفل فیلدها (عنوان، توضیحات)</span><span class=\"tgl\"></span></div>\n      "], ["<svg class=\"i\"><use href=\"#i-undo\"/></svg>", "هر انتقال برگشت‌پذیر", "اگر نتیجه را نپسندیدید، با یک کلیک به حالت قبل برگردید. لاگ ممیزی هم همه‌چیز را ثبت می‌کند.", "لاگ ممیزی", "\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-check\"/></svg> انتقال ۴۲ محصول</span><span class=\"chip ok\">موفق</span></div>\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-alert\"/></svg> ۳ محصول در انتظار تأیید قیمت</span><span class=\"chip o\">نگهبان</span></div>\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-refresh\"/></svg> تازه‌سازی قیمت</span><span class=\"chip ok\">موفق</span></div>\n        <div class=\"btn g\" style=\"margin-top:10px\"><svg class=\"i\"><use href=\"#i-undo\"/></svg> بازگردانی این انتقال</div>\n        <div class=\"input\" style=\"margin-top:6px\">$ wp kooch run --id=12</div>\n      "], ["<svg class=\"i\"><use href=\"#i-bell\"/></svg>", "اعلان و هوش مصنوعی", "خبر بگیرید با ایمیل، تلگرام، بله و وب‌هوک امضاشده. با کلید API خودتان، بازنویسی، ترجمه، یکدست‌سازی ویژگی‌ها و پیشنهاد دسته انجام می‌شود.", "تنظیمات کوچ", "\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-mail\"/></svg> ایمیل</span><span class=\"tgl\"></span></div>\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-send\"/></svg> تلگرام</span><span class=\"tgl\"></span></div>\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-chat\"/></svg> بله</span><span class=\"tgl\"></span></div>\n        <div class=\"line\"><span><svg class=\"i\"><use href=\"#i-hook\"/></svg> وب‌هوک امضاشده</span><span class=\"tgl off\"></span></div>\n        <div class=\"chips\" style=\"margin-top:8px\"><span class=\"chip o\"><svg class=\"i\"><use href=\"#i-spark\"/></svg> بازنویسی</span><span class=\"chip o\">ترجمه</span><span class=\"chip o\">یکدست‌سازی ویژگی‌ها</span><span class=\"chip o\">پیشنهاد دسته</span></div>\n      "], ["<svg class=\"i\"><use href=\"#i-lang\"/></svg>", "فارسی‌محور از پایه", "ترجمه‌ی کامل فارسی، راست‌چین، تاریخ جلالی و محافظت در برابر اشتباه ریال و تومان.", "ریال / تومان", "\n        <div class=\"line\"><span>تاریخ آخرین همگام‌سازی</span><b>۱۴۰۵/۰۷/۰۷</b></div>\n        <div class=\"line\"><span>قیمت منبع</span><b>۱۲٬۵۰۰٬۰۰۰ ریال</b></div>\n        <div class=\"line\"><span>تبدیل خودکار</span><b style=\"color:var(--ok)\">۱٬۲۵۰٬۰۰۰ تومان</b></div>\n        <div class=\"chip ok\" style=\"align-self:flex-start;margin-top:8px\"><svg class=\"i\"><use href=\"#i-check\"/></svg> محافظ ریال/تومان فعال</div>\n      "]]